rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isValidSettings(settings) {
      return settings is map
        && settings.keys().hasOnly([
          'lockScreenEnabled',
          'reminderHour',
          'reminderMinute',
          'lockScreenTopicIds'
        ])
        && settings.keys().hasAll([
          'lockScreenEnabled',
          'reminderHour',
          'reminderMinute'
        ])
        && settings.lockScreenEnabled is bool
        && settings.reminderHour is int
        && settings.reminderHour >= 0
        && settings.reminderHour <= 23
        && settings.reminderMinute is int
        && settings.reminderMinute >= 0
        && settings.reminderMinute <= 59
        && (!('lockScreenTopicIds' in settings)
            || (settings.lockScreenTopicIds is list && settings.lockScreenTopicIds.size() <= 20));
    }

    function hasValidSettings(data) {
      return !('settings' in data) || isValidSettings(data.settings);
    }

    function isValidWordProgress(data, uid) {
      return data is map
        && data.userId == uid
        && data.keys().hasOnly([
          'userId',
          'wordId',
          'topicId',
          'status',
          'boxLevel',
          'nextReviewAt',
          'updatedAt'
        ])
        && data.keys().hasAll(['userId', 'wordId', 'status', 'boxLevel'])
        && (data.status in ['NEW', 'LEARNING', 'REVIEW', 'MASTERED'])
        && data.boxLevel is int
        && data.boxLevel >= 1
        && data.boxLevel <= 5;
    }

    function canUpdateOwnProfile() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'avatarUrl',
          'avatarPath',
          'settings',
          'updatedAt'
        ])
        && hasValidSettings(request.resource.data);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && hasValidSettings(request.resource.data);
      allow update: if isOwner(uid) && canUpdateOwnProfile();
      allow delete: if false;

      match /auth_logs/{logId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /my_words/{wordId} {
        allow read, write: if isOwner(uid);
      }

      match /word_progress/{wordId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && isValidWordProgress(request.resource.data, uid);
      }

      match /study_events/{eventId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /sync_logs/{logId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /saved_topics/{topicId} {
        allow read, write: if isOwner(uid);
      }

      match /topic_progress/{topicId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /topics/{topicId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /words/{wordId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }
  }
}